  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2020"],
    "types": ["node"]
  },
  "include": [
    "src/core.ts",
    "src/node.ts",
    "src/index.node.ts",
    "src/types.ts",
    "src/pool.ts",
    "src/batch.node.ts",
    "src/worker/depixelize.worker-core.ts",
    "src/worker/depixelize.node-worker.ts"
  ]
}
