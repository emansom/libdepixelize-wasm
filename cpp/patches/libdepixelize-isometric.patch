+/**
+ * Return true if node \p n has a diagonal adjacency in direction (dx, dy).
+ *
+ * dx and dy must each be +1 or -1.
+ */
+static inline bool diag_adj(const PixelGraph::Node &n, int dx, int dy)
+{
+    if ( dx > 0 )
+        return dy > 0 ? n.adj.bottomright : n.adj.topright;
+    else
+        return dy > 0 ? n.adj.bottomleft : n.adj.topleft;
+}
+
+/**
+ * Isometric diagonal heuristic — rotation-invariant, region-adaptive.
+ *
+ * Detects if a diagonal connection a→b is part of one of three pattern
+ * families found in isometric pixel art sprites (which mix orientations):
+ *
+ * 1) 2:1 horizontal staircase (isometric X/Z-axis lines):
+ *    a has horizontal neighbor H away from b, b has horizontal neighbor J
+ *    away from a, both connected via adj.left/right.
+ *    Multi-step: H has a diagonal predecessor, J has a diagonal successor.
+ *
+ * 2) 1:2 vertical staircase (isometric Y-axis lines):
+ *    a has vertical neighbor V_a away from b, b has vertical neighbor V_b
+ *    away from a, both connected via adj.top/bottom.
+ *    Multi-step: V_a has a diagonal predecessor, V_b has a diagonal successor.
+ *
+ * 3) 1:1 diagonal continuation (forward-facing / normal pixel art):
+ *    a has a diagonal predecessor in (-dx,-dy), b has a diagonal successor
+ *    in (dx,dy). No cardinal neighbor check — pure diagonal chain.
+ *
+ * Each path scores +1 for single-step detection, +1 for multi-step
+ * confirmation.  Score range: 0–6.  Multiplied by isometric_weight (default 8).
+ */
+inline int Heuristics::isometric_diagonals(const PixelGraph &graph,
+                                           PixelGraph::const_iterator a,
+                                           PixelGraph::const_iterator b)
+{
+    int ax = graph.toX(a);
+    int ay = graph.toY(a);
+    int bx = graph.toX(b);
+    int by = graph.toY(b);
+
+    // a and b are diagonally adjacent: |dx|==1, |dy|==1
+    int dx = bx - ax;
+    int dy = by - ay;
+
+    int score = 0;
+
+    // Path 1: 2:1 horizontal staircase
+    // H=(ax-dx,ay) connected to a, J=(bx+dx,by) connected to b
+    {
+        int a_hx = ax - dx;
+        int b_hx = bx + dx;
+        if ( a_hx >= 0 && a_hx < graph.width()
+             && b_hx >= 0 && b_hx < graph.width() ) {
+            bool a_conn = (dx > 0) ? a->adj.left : a->adj.right;
+            bool b_conn = (dx > 0) ? b->adj.right : b->adj.left;
+            if ( a_conn && b_conn ) {
+                ++score;
+                // Multi-step: check predecessor diagonal from H, successor from J
+                PixelGraph::const_iterator h = a + (-dx);
+                PixelGraph::const_iterator j = b + dx;
+                if ( diag_adj(*h, -dx, -dy) || diag_adj(*j, dx, dy) )
+                    ++score;
+            }
+        }
+    }
+
+    // Path 2: 1:2 vertical staircase
+    // V_a=(ax,ay-dy) connected to a, V_b=(bx,by+dy) connected to b
+    {
+        int a_vy = ay - dy;
+        int b_vy = by + dy;
+        if ( a_vy >= 0 && a_vy < graph.height()
+             && b_vy >= 0 && b_vy < graph.height() ) {
+            bool a_conn = (dy > 0) ? a->adj.top : a->adj.bottom;
+            bool b_conn = (dy > 0) ? b->adj.bottom : b->adj.top;
+            if ( a_conn && b_conn ) {
+                ++score;
+                // Multi-step: check predecessor diagonal from V_a, successor from V_b
+                PixelGraph::const_iterator va = a + (-dy * graph.width());
+                PixelGraph::const_iterator vb = b + (dy * graph.width());
+                if ( diag_adj(*va, -dx, -dy) || diag_adj(*vb, dx, dy) )
+                    ++score;
+            }
+        }
+    }
+
+    // Path 3: 1:1 diagonal continuation (forward-facing pixel art)
+    // Predecessor: a has diagonal neighbor in (-dx,-dy)
+    // Successor: b has diagonal neighbor in (dx,dy)
+    {
+        bool pred = diag_adj(*a, -dx, -dy);
+        bool succ = diag_adj(*b, dx, dy);
+        if ( pred )
+            ++score;
+        if ( succ )
+            ++score;
+    }
+
+    return score;
+}
