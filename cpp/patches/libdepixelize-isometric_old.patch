+/**
+ * Isometric diagonal heuristic.
+ *
+ * Detects if a diagonal connection is part of a 2:1 or 1:2 "staircase"
+ * pattern typical in isometric pixel art (dimetric projection).
+ *
+ * For a diagonal a→b in a 2x2 crossing block, checks whether:
+ * - a has a connected cardinal neighbor on the side away from b
+ * - b has a connected cardinal neighbor on the side away from a
+ *
+ * This confirms the diagonal links two "steps" of a staircase, each step
+ * being 2 pixels wide (horizontal case) or 2 pixels tall (vertical case).
+ *
+ * Returns 0, 1, or 2 depending on how many staircase directions are detected.
+ */
+inline int Heuristics::isometric_diagonals(const PixelGraph &graph,
+                                           PixelGraph::const_iterator a,
+                                           PixelGraph::const_iterator b)
+{
+    int ax = graph.toX(a);
+    int ay = graph.toY(a);
+    int bx = graph.toX(b);
+    int by = graph.toY(b);
+
+    // a and b are diagonally adjacent: |dx|==1, |dy|==1
+    int dx = bx - ax;
+    int dy = by - ay;
+
+    int score = 0;
+
+    // 2:1 horizontal staircase:
+    // a's horizontal neighbor away from b (opposite x-direction)
+    // b's horizontal neighbor away from a (same x-direction as b from a)
+    {
+        int a_hx = ax - dx;
+        int b_hx = bx + dx;
+        if ( a_hx >= 0 && a_hx < graph.width()
+             && b_hx >= 0 && b_hx < graph.width() ) {
+            bool a_conn = (dx > 0) ? a->adj.left : a->adj.right;
+            bool b_conn = (dx > 0) ? b->adj.right : b->adj.left;
+            if ( a_conn && b_conn )
+                ++score;
+        }
+    }
+
+    // 1:2 vertical staircase:
+    // a's vertical neighbor away from b (opposite y-direction)
+    // b's vertical neighbor away from a (same y-direction as b from a)
+    {
+        int a_vy = ay - dy;
+        int b_vy = by + dy;
+        if ( a_vy >= 0 && a_vy < graph.height()
+             && b_vy >= 0 && b_vy < graph.height() ) {
+            bool a_conn = (dy > 0) ? a->adj.top : a->adj.bottom;
+            bool b_conn = (dy > 0) ? b->adj.bottom : b->adj.top;
+            if ( a_conn && b_conn )
+                ++score;
+        }
+    }
+
+    return score;
+}
+
