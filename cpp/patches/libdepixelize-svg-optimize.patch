diff --git a/src/depixelize/splines-impl.h b/src/depixelize/splines-impl.h
index 8030167..d9e6f6b 100644
--- a/src/depixelize/splines-impl.h
+++ b/src/depixelize/splines-impl.h
@@ -33,6 +33,31 @@ Geom::Path worker_helper(const std::vector< Point<T> > &source1, bool optimize)
     else
         source = source1;
 
+    // Remove collinear points — reduces LineSegment count for merged polygons
+    if ( source.size() > 3 ) {
+        std::vector<bool> keep(source.size(), true);
+        for ( size_t i = 0 ; i < source.size() ; ++i ) {
+            size_t pi = (i == 0) ? source.size() - 1 : i - 1;
+            size_t ni = (i + 1) % source.size();
+            const auto &a = source[pi];
+            const auto &b = source[i];
+            const auto &c = source[ni];
+            bool same_flags = (a.smooth == b.smooth && b.smooth == c.smooth
+                            && a.visible == b.visible && b.visible == c.visible);
+            bool collinear = ((b.x - a.x) * (c.y - a.y)
+                           == (c.x - a.x) * (b.y - a.y));
+            if ( same_flags && collinear )
+                keep[i] = false;
+        }
+        size_t write = 0;
+        for ( size_t i = 0 ; i < source.size() ; ++i ) {
+            if ( keep[i] )
+                source[write++] = source[i];
+        }
+        if ( write >= 3 )
+            source.resize(write);
+    }
+
     iterator it = source.begin();
     Point<T> prev = source.back();
     Geom::Path ret(to_geom_point(midpoint(prev, *it)));
